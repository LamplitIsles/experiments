{
  "name": "experiments",
  "private": true,
  "workspaces": [
    "flicklog",
    "utterlog"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "typecheck": "bun run --workspaces typecheck",
    "test": "bun run --workspaces test",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "lefthook": "2.1.14",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0"
  },
  "packageManager": "bun@1.3.14"
}
